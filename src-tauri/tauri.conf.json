{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "knitt",
  "version": "0.1.0",
  "identifier": "app.nativegitclient.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "knitt",
        "width": 1100,
        "height": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "publisher": "knitt",
    "homepage": "https://github.com/Tazorx7/knitt",
    "shortDescription": "Native Git client for Linux",
    "longDescription": "Knitt is a Git client for Linux built with Tauri and libgit2: staging, history editing, merge and rebase with conflict resolution, GitHub integration and Git LFS.",
    "copyright": "Apache-2.0",
    "license": "Apache-2.0",
    "licenseFile": "../LICENSE"
  }
}
